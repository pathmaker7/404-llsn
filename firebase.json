{
  "hosting": [
    {
      "site": "lunar-navigator-404",
      "public": "app",
      "ignore": [
        "**/.*"
      ],
      "headers": [
        {
          "source": "data/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=3600"
            }
          ]
        },
        {
          "source": "**/*.@(html|js|css|json|mp4|pdf)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ],
      "redirects": [
        {
          "source": "/surface",
          "destination": "/",
          "type": 302
        },
        {
          "source": "/surface/**",
          "destination": "/",
          "type": 302
        }
      ]
    },
    {
      "site": "lunar-navigator-explained",
      "public": "explainer",
      "ignore": [
        "**/.*"
      ],
      "headers": [
        {
          "source": "**/*.@(html|js|css|json|mp4)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "**/*.pdf",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=0, s-maxage=604800, no-transform"
            }
          ]
        },
        {
          "source": "/",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ]
    }
  ]
}
